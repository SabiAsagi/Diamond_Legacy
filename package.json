{
  "name": "diamond-legacy",
  "private": true,
  "version": "2.3.0",
  "type": "module",
  "scripts": {
    "dev": "npm run kits && vite",
    "build": "npm run kits && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "npm run kits && node --test tests/career.cjs tests/v2_features.cjs tests/freshman_year.cjs",
    "test:freshman": "node --test tests/freshman_year.cjs",
    "kits": "node scripts/build-school-kits.mjs",
    "build:desktop-assets": "npm run kits && tsc -b && vite build --base=./",
    "desktop": "npm run build:desktop-assets && electron .",
    "build:steam": "npm run build:desktop-assets && node scripts/build-desktop.cjs dir",
    "build:windows": "npm run build:desktop-assets && node scripts/build-desktop.cjs portable"
  },
  "dependencies": {
    "dexie": "^4.4.5",
    "lucide-react": "^1.38.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@genex-ai/cli-demo": "^1.35.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.79.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  },
  "main": "desktop/main.cjs",
  "description": "Diamond Legacy — 한국 야구 선수 육성과 구단 운영 시뮬레이션",
  "author": "SabiAsagi",
  "build": {
    "appId": "com.sabiasagi.diamondlegacy",
    "productName": "Diamond Legacy",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "dir"
      ],
      "artifactName": "Diamond-Legacy-${version}-${arch}.${ext}",
      "signAndEditExecutable": false
    }
  }
}
